<mujoco model="fairy">
  <compiler angle="radian" meshdir="meshes"/>

  <option iterations="3" ls_iterations="5" timestep="0.002" integrator="implicitfast">
    <flag eulerdamp="disable"/>
  </option>

  <default>
    <joint limited='true' />
    <motor ctrllimited='true' />
    <geom condim='4' contype="1" conaffinity="15" solref='0.001 2' friction='0.9 0.2 0.2' />
    <equality solref='0.001 2' />
    <default class='visualgeom'>
      <geom material='visualgeom' condim='1' contype='0' conaffinity='0' />
    </default>
    <default class='visualgeom2'>
      <geom material='visualgeom2' condim='1' contype='0' conaffinity='0' />
    </default>
    <default class='obstacle'>
      <geom material='obstacle' condim='3' contype='1' conaffinity='15' />
    </default>
    
    <default class='joint_param'>
      <joint damping="1" frictionloss="1" armature="0.01" />
    </default>

    <default class="collision">
        <geom group="3" mass="0" density="0"/>
        <default class="foot">
          <geom type="sphere" size=".001"/>
          <default class="foot1">
            <geom size="0.001" contype="0" conaffinity="0" density="0"/>
          </default>
          <default class="foot2">
            <geom size="0.001"/>
          </default>
        </default>
    </default>

    <default class="fairy_motor">
      <geom contype="0" conaffinity="0"/>
      <position inheritrange="1" dampratio="1"/>
      <joint damping="0.00" frictionloss="0.2"/>
    </default>
  </default>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512"
      height="512" />
    <texture name="texplane" type="2d" builtin="checker" rgb1=".2 .3 .4" rgb2=".1 0.15 0.2"
      width="512" height="512" mark="cross" markrgb=".8 .8 .8" />
    <texture name="texplane2" type="2d" builtin="checker" rgb1="1 0.3137 0.1843"
      rgb2="0.0 0.30196 0.38039"
      width="512" height="512" mark="cross" markrgb=".8 .8 .8" />
    <material name="matplane" reflectance="0." texture="texplane" texrepeat="1 1" texuniform="true" />
    <material name="matplane2" reflectance="0.1" texture="texplane2" texrepeat="1 1"
      texuniform="true" />

    <material name='obstacle' rgba='0.9 0.6 0.2 1' />
    <material name='visualgeom' rgba='0.5 0.9 0.2 1' />
    <material name='visualgeom2' rgba='0.5 0.9 0.2 1' />

    <mesh name="base" file="BASE.STL"/>
    <mesh name="lhip" file="LHIP.STL"/>
    <mesh name="luleg" file="LULEG.STL"/>
    <mesh name="llleg" file="LLLEG.STL"/>
    <mesh name="ltoe" file="LTOE.STL"/>
    <mesh name="rhip" file="RHIP.STL"/>
    <mesh name="ruleg" file="RULEG.STL"/>
    <mesh name="rlleg" file="RLLEG.STL"/>
    <mesh name="rtoe" file="RTOE.STL"/>
  </asset>

  <worldbody>
    <!-- Light source -->
    <light directional="true" diffuse=".4 .4 .4" specular="0.1 0.1 0.1" pos="0 0 5.0" dir="0 0 -1"
      castshadow="false" />
    <light directional="true" diffuse=".6 .6 .6" specular="0.2 0.2 0.2" pos="0 0 4" dir="0 0 -1" />
    <!-- Ground plane -->
    <geom name="ground" type="plane" size="10 10 0.01" pos="0 0 0" quat="1 0 0 0" material="matplane"
      condim="3" conaffinity="0" friction="0.6" contype="1"/>
    <!-- Base link (floating) -->
    <!-- Initial position matches keyframe "crouch" for consistency -->
    <body name="base_link" pos="0 0 0.85" quat="1 0 0 0">
      <joint type='slide' axis='1 0 0' limited='false' />
      <joint type='slide' axis='0 1 0' limited='false' />
      <joint type='slide' axis='0 0 1' limited='false' />
      <joint type='ball' limited='false' />
      <inertial pos="0 0 0" mass="3.0"
                  diaginertia="0.0185 0.023125 0.017425"/>
      <geom size="0.105 0.08 0.11" pos="0 0.0 0.0" quat="1 0 0 0"
        type="box" rgba="0.75294 0.75294 0.75294 1" />
      <camera name="track" pos="1.248 -0.947 0.3" xyaxes="0.628 0.779 -0.000 -0.274 0.221 0.936" mode="trackcom"/>
      <!-- IMU sensor -->
      <site name="imu" pos="0 0 0" size="0.01"/>
      <body name="lower_base_link" pos="0 0 -0.19" quat="1 0 0 0">
        <inertial pos="0 0 -0.00474" mass="9.72349"
                  diaginertia="0.07842643393798777 0.06327906149316344 0.10124929098058508"/>
        <!-- Visual mesh (no collision) -->
        <geom type="mesh" mesh="base" rgba="1 1 1 1" contype="0" conaffinity="0"/>
        <!-- Collision box -->
        <geom type="box" size="0.12 0.08 0.04" pos="0 0 -0.005" rgba="0.5 0.5 0.5 0.3"/>

        <!-- Right leg (Motor ID 1-4) -->
        <body name="R_FOOT" pos="0 -0.08 0">
          <body name="R1" pos="0 0 0">
            <joint name="leg_r1_joint" axis="1 0 0"
                  range="-2.094 2.094" limited="true" frictionloss="0.2"/>
            <inertial pos="0 0 0" mass="1.23047" diaginertia="0.0018303633358577802 0.0039401153269064335 0.0035094898580769786"/>
            <!-- Visual mesh (no collision) -->
            <geom type="mesh" mesh="rhip" rgba="1 1 1 1" contype="0" conaffinity="0"/>
            <!-- Collision capsule -->
            <geom type="capsule" fromto="0 0 0 0 -0.065 0" size="0.03" rgba="0.5 0.5 0.5 0.3"/>

            <body name="R2" pos="0 -0.065 0">
              <joint name="leg_r2_joint" axis="0 1 0"
                    range="-3.14 3.14" limited="true" frictionloss="0.2"/>
              <inertial pos="0.0 0 -0.11924" mass="2.06632"
                        diaginertia="0.028423839552622263 0.027088604867877116 0.006885361957140555"/>
              <!-- Visual mesh (no collision) -->
              <geom type="mesh" mesh="ruleg" rgba="1 1 1 1" contype="0" conaffinity="0"/>
              <!-- Collision capsule for upper leg -->
              <geom type="capsule" fromto="0 0 0 0 0 -0.26" size="0.035" rgba="0.5 0.5 0.5 0.3"/>

              <body name="R3" pos="0 0 -0.26">
                <joint name="leg_r3_joint" axis="0 1 0"
                      range="-2.094 3.142" limited="true" frictionloss="0.2"/>
                <inertial pos="0 0 -0.15" mass="0.41492"
                          diaginertia="0.004368293950062158 0.0043649330449301435 0.0007692542542232213"/>
                <!-- Visual mesh (no collision) -->
                <geom type="mesh" mesh="rlleg" rgba="1 1 1 1" contype="0" conaffinity="0"/>
                <!-- Collision capsule for lower leg -->
                <geom type="capsule" fromto="0 0 0 0 0 -0.30056" size="0.025" rgba="0.5 0.5 0.5 0.3"/>

                <body name="R4" pos="0 0 -0.30056">
                  <joint name="leg_r4_joint" axis="0 1 0"
                        range="-0.785 1.571" limited="true" frictionloss="0.2"/>
                  <inertial pos="0 0 -0.04246" mass="0.3"
                            diaginertia="0.00036615939455986174 0.0005477740783050022 0.0007028353336951787"/>
                  <!-- Visual mesh (no collision) -->
                  <geom type="mesh" mesh="rtoe" rgba="1 1 1 1" contype="0" conaffinity="0"/>
                  <!-- Collision box for toe (1.5x size for stability) -->
                  <geom type="box" size="0.06 0.045 0.03" pos="0.01 0 -0.02" rgba="0.5 0.5 0.5 0.3"/>
                  <geom name="right_foot1" class="foot1"/>
                  <geom name="right_foot2" class="foot2"/> 
                  <geom name="right_foot" class="foot"/>
                  <site name ="right_foot" pos="0 0 0" />
                </body>
              </body>
            </body>
          </body>
        </body>

        <!-- Left leg (Motor ID 5-8) -->
        <body name="L_FOOT" pos="0 0.08 0">
          <body name="L1" pos="0 0 0">
            <joint name="leg_l1_joint" axis="1 0 0" range="-2.094 2.094" limited="true" frictionloss="0.2"/>
            <inertial pos="0 0 0" mass="1.23047" diaginertia="0.0018233989548339167 0.003940115487341474 0.003502525316618075"/>
            <!-- Visual mesh (no collision) -->
            <geom type="mesh" mesh="lhip" rgba="1 1 1 1" contype="0" conaffinity="0"/>
            <!-- Collision capsule -->
            <geom type="capsule" fromto="0 0 0 0 0.065 0" size="0.03" rgba="0.5 0.5 0.5 0.3"/>

            <body name="L2" pos="0 0.065 0">
              <joint name="leg_l2_joint" axis="0 1 0" range="-3.14 3.14"  limited="true" frictionloss="0.2"/>
              <inertial pos="0.00006 0 -0.11924" mass="2.06632"
                        diaginertia="0.028423839552622263 0.027088604867877116 0.006885361957140555"/>
              <!-- Visual mesh (no collision) -->
              <geom type="mesh" mesh="luleg" rgba="1 1 1 1" contype="0" conaffinity="0"/>
              <!-- Collision capsule for upper leg -->
              <geom type="capsule" fromto="0 0 0 0 0 -0.26" size="0.035" rgba="0.5 0.5 0.5 0.3"/>

              <body name="L3" pos="0 0 -0.26">
                <joint name="leg_l3_joint" axis="0 1 0"
                      range="-2.094 3.142"  limited="true" frictionloss="0.2"/>
                <inertial pos="0 0 -0.15" mass="0.41492"
                          diaginertia="0.004368293950062158 0.0043649330449301435 0.0007692542542232213"/>
                <!-- Visual mesh (no collision) -->
                <geom type="mesh" mesh="llleg" rgba="1 1 1 1" contype="0" conaffinity="0"/>
                <!-- Collision capsule for lower leg -->
                <geom type="capsule" fromto="0 0 0 0 0 -0.30056" size="0.025" rgba="0.5 0.5 0.5 0.3"/>

                <body name="L4" pos="0 0 -0.30056">
                  <joint name="leg_l4_joint" axis="0 1 0"
                        range="-0.785 1.571" limited="true" frictionloss="0.2"/>
                  <inertial pos="0 0 -0.04246" mass="0.3"
                            diaginertia="0.00036615939455986174 0.0005477740783050022 0.0007028353336951787"/>
                  <!-- Visual mesh (no collision) -->
                  <geom type="mesh" mesh="ltoe" rgba="1 1 1 1" contype="0" conaffinity="0"/>
                  <!-- Collision box for toe (1.5x size for stability) -->
                  <geom type="box" size="0.06 0.045 0.03" pos="0.01 0 -0.02" rgba="0.5 0.5 0.5 0.3"/>
                  <geom name="left_foot1" class="foot1"/>
                  <geom name="left_foot2" class="foot2"/> 
                  <geom name="left_foot" class="foot"/> 
                  <site name="left_foot" pos="0 0 0" />
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <position class="fairy_motor" name="leg_l1_joint" joint="leg_l1_joint" forcerange="-60 60" kp="15" kv="1.0"/>
    <position class="fairy_motor" name="leg_l2_joint" joint="leg_l2_joint" forcerange="-60 60" kp="15" kv="1.5"/>
    <position class="fairy_motor" name="leg_l3_joint" joint="leg_l3_joint" forcerange="-60 60" kp="25" kv="2.5"/>
    <position class="fairy_motor" name="leg_l4_joint" joint="leg_l4_joint" forcerange="-36 36" kp="5" kv="0.1"/>

    <position class="fairy_motor" name="leg_r1_joint" joint="leg_r1_joint" forcerange="-60 60" kp="15" kv="1.0"/>
    <position class="fairy_motor" name="leg_r2_joint" joint="leg_r2_joint" forcerange="-60 60" kp="15" kv="1.5"/>
    <position class="fairy_motor" name="leg_r3_joint" joint="leg_r3_joint" forcerange="-60 60" kp="25" kv="2.5"/>
    <position class="fairy_motor" name="leg_r4_joint" joint="leg_r4_joint" forcerange="-36 36" kp="5" kv="0.1"/>
  </actuator>

  <sensor>
    <actuatorpos name='leg_l1_joint_p' actuator='leg_l1_joint' user='13' />
    <actuatorpos name='leg_l2_joint_p' actuator='leg_l2_joint' user='13' />
    <actuatorpos name='leg_l3_joint_p' actuator='leg_l3_joint' user='13' />
    <actuatorpos name='leg_l4_joint_p' actuator='leg_l4_joint' user='13' />
    <actuatorpos name='leg_r1_joint_p' actuator='leg_r1_joint' user='13' />
    <actuatorpos name='leg_r2_joint_p' actuator='leg_r2_joint' user='13' />
    <actuatorpos name='leg_r3_joint_p' actuator='leg_r3_joint' user='13' />
    <actuatorpos name='leg_r4_joint_p' actuator='leg_r4_joint' user='13' />

    <actuatorvel name='leg_l1_joint_v' actuator='leg_l1_joint' user='13' />
    <actuatorvel name='leg_l2_joint_v' actuator='leg_l2_joint' user='13' />
    <actuatorvel name='leg_l3_joint_v' actuator='leg_l3_joint' user='13' />
    <actuatorvel name='leg_l4_joint_v' actuator='leg_l4_joint' user='13' />
    <actuatorvel name='leg_r1_joint_v' actuator='leg_r1_joint' user='13' />
    <actuatorvel name='leg_r2_joint_v' actuator='leg_r2_joint' user='13' />
    <actuatorvel name='leg_r3_joint_v' actuator='leg_r3_joint' user='13' />
    <actuatorvel name='leg_r4_joint_v' actuator='leg_r4_joint' user='13' />

    <actuatorfrc name='leg_l1_joint_f' actuator='leg_l1_joint' user='13' />
    <actuatorfrc name='leg_l2_joint_f' actuator='leg_l2_joint' user='13' />
    <actuatorfrc name='leg_l3_joint_f' actuator='leg_l3_joint' user='13' />
    <actuatorfrc name='leg_l4_joint_f' actuator='leg_l4_joint' user='13' />
    <actuatorfrc name='leg_r1_joint_f' actuator='leg_r1_joint' user='13' />
    <actuatorfrc name='leg_r2_joint_f' actuator='leg_r2_joint' user='13' />
    <actuatorfrc name='leg_r3_joint_f' actuator='leg_r3_joint' user='13' />
    <actuatorfrc name='leg_r4_joint_f' actuator='leg_r4_joint' user='13' />

    <!-- IMU sensor -->
    <gyro site="imu" name="gyro"/>
    <velocimeter site="imu" name="local_linvel"/>
    <accelerometer site="imu" name="accelerometer"/>
    <framepos objtype="site" objname="imu" name="position"/>
    <framezaxis objtype="site" objname="imu" name="upvector"/>
    <framexaxis objtype="site" objname="imu" name="forwardvector"/>
    <framelinvel objtype="site" objname="imu" name="global_linvel"/>
    <frameangvel objtype="site" objname="imu" name="global_angvel"/>
    <framequat objtype="site" objname="imu" name="orientation"/>
    <framelinvel objtype="site" objname="right_foot" name="right_foot_global_linvel"/>
    <framelinvel objtype="site" objname="left_foot" name="left_foot_global_linvel"/>
  </sensor>

  <keyframe>
    <!-- Initial crouch pose (pose_Z): [0, -145, 158.9, -43, 0, -145, 158.9, -43] degrees -->
    <!-- This is used for Backspace reset -->
    <!-- <key name="crouch"
         qpos="0 0 0.7 1 0 0 0
               0 -2.531 2.774 -0.750
               0 -2.531 2.774 -0.750"/> -->

    <!-- Default starting pose (same as crouch for consistency) -->
    <!-- <key name="home"
         qpos="0 0 0.7 1 0 0 0
               0 -2.531 2.774 -0.750
               0 -2.531 2.774 -0.750"/> -->
  </keyframe>
</mujoco>
