    <default class="hunter_motor_1">
      <joint damping="1.0" armature="0.1" actuatorfrcrange="-36 36"/>
    </default>
    <default class="hunter_motor_2">
      <joint damping="0.5" armature="0.1" actuatorfrcrange="-36 36"/>
